# kyb-tool-mcp configuration. Copy to .env (never commit .env) or set these in your MCP client config.
# Free Companies House key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=
# Optional
# KYB_DATA_DIR=~/.kyb-tool-mcp      # sanctions index, HTTP cache, audit log
# KYB_POLICY_FILE=./policy.yaml     # from `kyb-tool-mcp init`
# KYB_PROVIDERS_FILE=./providers.yaml
# KYB_AUDIT=true
# KYB_HTTP_CACHE=true
